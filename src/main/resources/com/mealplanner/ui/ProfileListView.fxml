<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17.0.2-ea" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mealplanner.ui.ProfileListController">
   <top>
      <VBox spacing="10.0">
         <children>
            <Label styleClass="header-label" text="Manage Family Profiles" />
            <Label text="Create, edit, or delete family member profiles" wrapText="true" />
            <Separator />
         </children>
         <padding>
            <Insets bottom="15.0" left="20.0" right="20.0" top="20.0" />
         </padding>
      </VBox>
   </top>
   <center>
      <VBox spacing="15.0">
         <children>
            <!-- Profiles List -->
            <VBox spacing="10.0">
               <children>
                  <HBox alignment="CENTER_LEFT" spacing="10.0">
                     <children>
                        <Label styleClass="section-header" text="Family Members" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Button fx:id="addProfileButton" onAction="#handleAddProfile" styleClass="primary-button" text="+ Add New Profile" />
                     </children>
                  </HBox>
                  <ListView fx:id="profilesListView" prefHeight="300.0">
                     <placeholder>
                        <Label text="No profiles created yet. Click 'Add New Profile' to get started." />
                     </placeholder>
                  </ListView>
               </children>
            </VBox>
            
            <!-- Action Buttons -->
            <HBox alignment="CENTER_LEFT" spacing="10.0">
               <children>
                  <Button fx:id="editProfileButton" disable="true" onAction="#handleEditProfile" text="Edit Selected" />
                  <Button fx:id="deleteProfileButton" disable="true" onAction="#handleDeleteProfile" text="Delete Selected" />
                  <Region HBox.hgrow="ALWAYS" />
                  <Label fx:id="profileCountLabel" text="0 profiles" />
               </children>
            </HBox>
         </children>
         <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="10.0" />
         </padding>
      </VBox>
   </center>
   <bottom>
      <HBox alignment="CENTER_RIGHT" spacing="15.0">
         <children>
            <Button fx:id="closeButton" onAction="#handleClose" text="Close" />
         </children>
         <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="15.0" />
         </padding>
      </HBox>
   </bottom>
</BorderPane>
