<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox xmlns="http://javafx.com/javafx/17.0.2-ea" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mealplanner.ui.RecipeCardController">
   <children>
      <VBox styleClass="recipe-card" spacing="10.0">
         <padding>
            <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
         </padding>
         
         <!-- Recipe Name Section -->
         <VBox spacing="5.0">
            <Label fx:id="recipeNameEnLabel" styleClass="recipe-name-en" text="Recipe Name (English)" wrapText="true">
               <font>
                  <Font name="System Bold" size="16.0" />
               </font>
            </Label>
            <Label fx:id="recipeNameBnLabel" styleClass="recipe-name-bn" text="রেসিপি নাম (বাংলা)" wrapText="true">
               <font>
                  <Font size="14.0" />
               </font>
            </Label>
         </VBox>
         
         <!-- Recipe Details Section -->
         <GridPane hgap="10.0" vgap="5.0">
            <columnConstraints>
               <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" />
               <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" />
            </columnConstraints>
            <rowConstraints>
               <RowConstraints />
               <RowConstraints />
               <RowConstraints />
            </rowConstraints>
            
            <Label text="Servings:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
            <Label fx:id="servingsLabel" text="4" GridPane.columnIndex="1" GridPane.rowIndex="0" />
            
            <Label text="Prep Time:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
            <Label fx:id="prepTimeLabel" text="30 min" GridPane.columnIndex="1" GridPane.rowIndex="1" />
            
            <Label text="Cook Time:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
            <Label fx:id="cookTimeLabel" text="45 min" GridPane.columnIndex="1" GridPane.rowIndex="2" />
         </GridPane>
         
         <!-- Tags Section -->
         <VBox spacing="5.0">
            <Label styleClass="section-header" text="Tags:">
               <font>
                  <Font name="System Bold" size="12.0" />
               </font>
            </Label>
            <FlowPane fx:id="tagsFlowPane" hgap="5.0" vgap="5.0" />
         </VBox>
         
         <!-- Basic Nutrition Section -->
         <VBox spacing="5.0">
            <Label styleClass="section-header" text="Nutrition Information:">
               <font>
                  <Font name="System Bold" size="12.0" />
               </font>
            </Label>
            <GridPane fx:id="basicNutritionGrid" hgap="10.0" vgap="5.0">
               <columnConstraints>
                  <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" />
                  <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" />
               </columnConstraints>
            </GridPane>
            <Hyperlink fx:id="viewAllNutrientsLink" onAction="#toggleAllNutrients" text="View All Nutrients" />
         </VBox>
         
         <!-- All Nutrients Section (Initially Hidden) -->
         <VBox fx:id="allNutrientsSection" managed="false" spacing="5.0" visible="false">
            <Label styleClass="section-header" text="Complete Nutrition Profile:">
               <font>
                  <Font name="System Bold" size="12.0" />
               </font>
            </Label>
            <GridPane fx:id="allNutrientsGrid" hgap="10.0" vgap="5.0">
               <columnConstraints>
                  <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" />
                  <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" />
               </columnConstraints>
            </GridPane>
         </VBox>
         
         <!-- Ingredients Section -->
         <VBox spacing="5.0" styleClass="recipe-section">
            <Label styleClass="section-header" text="Ingredients:">
               <font>
                  <Font name="System Bold" size="12.0" />
               </font>
            </Label>
            <VBox fx:id="ingredientsVBox" spacing="3.0" styleClass="ingredients-container">
               <padding>
                  <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
               </padding>
            </VBox>
         </VBox>
         
         <!-- Instructions Section -->
         <TitledPane animated="false" expanded="true" styleClass="recipe-section" text="Instructions">
            <content>
               <VBox fx:id="instructionsVBox" spacing="5.0">
                  <padding>
                     <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                  </padding>
               </VBox>
            </content>
         </TitledPane>
         
         <!-- Family Notes Section (hidden by default) -->
         <TitledPane fx:id="familyNotesSection" animated="false" styleClass="recipe-section" text="Family Considerations" managed="false" visible="false">
            <content>
               <VBox fx:id="familyNotesVBox" spacing="5.0">
                  <padding>
                     <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                  </padding>
               </VBox>
            </content>
         </TitledPane>
         
      </VBox>
   </children>
</VBox>
